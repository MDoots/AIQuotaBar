<Window x:Class="AIQuotaBar.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:AIQuotaBar.App.Converters"
        xmlns:vm="clr-namespace:AIQuotaBar.App.ViewModels"
        mc:Ignorable="d"
        Title="AIQuotaBar"
        Icon="/Assets/AIQuotaBar.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsAlwaysOnTop}"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        SizeToContent="Height"
        MinWidth="200"
        MaxWidth="1220"
        MaxHeight="620"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif"
        d:DataContext="{d:DesignInstance vm:WidgetViewModel}">

    <Window.Resources>
        <conv:RemainingToBrushConverter x:Key="RemainingToBrushConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BooleanToVisibilityConverter x:Key="InvBoolToVisConverter" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConverter" />

        <Style x:Key="WidgetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#18181B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="10"
            HorizontalAlignment="Stretch">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45" />
        </Border.Effect>

        <Grid Margin="10,8,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Action Bar -->
                <RowDefinition Height="*" MaxHeight="520" />  <!-- Stacked Provider Sections -->
                <RowDefinition Height="Auto" /> <!-- Footer (Expanded mode) -->
            </Grid.RowDefinitions>

            <!-- 1. Top Action Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title / Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppTitleText}" FontWeight="Bold" FontSize="12.5" Foreground="#E4E4E7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Window Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource WidgetButtonStyle}" Command="{Binding ToggleModeCommand}" ToolTip="{Binding ModeToggleTooltip}" Width="22" Height="22" Margin="0,0,2,0">
                        <TextBlock Text="{Binding ModeToggleText}" FontSize="12" FontWeight="Bold" Margin="0,-1,0,0" />
                    </Button>
                    <Button Style="{StaticResource WidgetButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="Refresh Quotas" Width="22" Height="22" Margin="0,0,2,0">
                        <TextBlock Text="⟳" FontSize="13" FontWeight="Bold" RenderTransformOrigin="0.5,0.5" />
                    </Button>
                    <Button Style="{StaticResource WidgetButtonStyle}" Click="MinimizeButton_Click" ToolTip="Hide to System Tray" Width="22" Height="22" Margin="0,0,2,0">
                        <TextBlock Text="−" FontSize="13" FontWeight="Bold" Margin="0,-2,0,0" />
                    </Button>
                    <Button Style="{StaticResource WidgetButtonStyle}" Click="CloseButton_Click" ToolTip="Exit AIQuotaBar" Width="22" Height="22">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Stacked Provider Sections -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2,0,6" Background="#1C1C20" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" Padding="8,6">
                                <StackPanel>
                                    <!-- Provider Section Header -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Provider Name & Status Dot -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{Binding ProviderAccentColor}" Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayProviderName}" FontWeight="SemiBold" FontSize="11.5" Foreground="#FAFAFA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <!-- Plan Badge (Full mode + Expanded view only) -->
                                            <Border Background="#27272A" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowAccountPlan, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding AccountPlan}" FontSize="10" Foreground="#A1A1AA" FontWeight="Medium" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Provider Quota Windows -->
                                    <ItemsControl ItemsSource="{Binding Windows}" Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,1,0,3" Background="#242429" CornerRadius="5" Padding="7,5" 
                                                        ToolTip="{Binding TooltipText}"
                                                        AutomationProperties.Name="{Binding AccessibilityText}">
                                                    <StackPanel>
                                                        <!-- Window Header -->
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Window Title -->
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="11" Foreground="#F4F4F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                            <!-- Remaining & Countdown info -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                <TextBlock Text="{Binding RemainingText}" 
                                                                           FontWeight="Bold" 
                                                                           FontSize="11" 
                                                                           Foreground="{Binding RemainingPercent, Converter={StaticResource RemainingToBrushConverter}}" 
                                                                           Margin="{Binding RemainingMargin}" />

                                                                <TextBlock Text="{Binding ResetCountdown}" 
                                                                           FontSize="10" 
                                                                           Foreground="#71717A" 
                                                                           Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVisConverter}}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Progress Bar (Showing Remaining Quota) -->
                                                        <Grid Height="4" Margin="0,1,0,1">
                                                            <ProgressBar Value="{Binding RemainingPercent, Mode=OneWay}" 
                                                                         Minimum="0" 
                                                                         Maximum="100" 
                                                                         Height="4" 
                                                                         BorderThickness="0" 
                                                                         Background="#333338"
                                                                         Foreground="{Binding RemainingPercent, Converter={StaticResource RemainingToBrushConverter}}">
                                                                <ProgressBar.Template>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Grid x:Name="TemplateRoot" Height="{TemplateBinding Height}">
                                                                            <Border x:Name="PART_Track" 
                                                                                    Background="{TemplateBinding Background}" 
                                                                                    CornerRadius="2" />
                                                                            <Border x:Name="PART_Indicator" 
                                                                                    HorizontalAlignment="Left" 
                                                                                    Background="{TemplateBinding Foreground}" 
                                                                                    CornerRadius="2" />
                                                                        </Grid>
                                                                    </ControlTemplate>
                                                                </ProgressBar.Template>
                                                            </ProgressBar>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Provider Status / Error Message -->
                                    <Border Background="#27272A" CornerRadius="5" Padding="7,5" Margin="0,2,0,2"
                                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ℹ" FontSize="11" Foreground="#F59E0B" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" Foreground="#D4D4D8" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3. Footer (Expanded mode only) -->
            <Grid Grid.Row="2" Margin="0,4,0,0" Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVisConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding LastUpdatedText}" FontSize="9.5" Foreground="#71717A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Refreshing..." FontSize="9.5" Foreground="#10B981" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
