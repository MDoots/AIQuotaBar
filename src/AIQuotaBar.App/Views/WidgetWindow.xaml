<Window x:Class="AIQuotaBar.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:AIQuotaBar.App.Converters"
        xmlns:vm="clr-namespace:AIQuotaBar.App.ViewModels"
        mc:Ignorable="d"
        Title="AIQuotaBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif"
        d:DataContext="{d:DesignInstance vm:WidgetViewModel}">

    <Window.Resources>
        <conv:RemainingToBrushConverter x:Key="RemainingToBrushConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BooleanToVisibilityConverter x:Key="InvBoolToVisConverter" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConverter" />

        <Style x:Key="WidgetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#18181B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="10"
            Width="340">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45" />
        </Border.Effect>

        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Body / Quota Windows -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Provider Badge & Plan -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" Width="7" Height="7" CornerRadius="3.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold" FontSize="13" Foreground="#FAFAFA" VerticalAlignment="Center" />

                    <Border Background="#27272A" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasAccountPlan, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding AccountPlan}" FontSize="11" Foreground="#A1A1AA" FontWeight="Medium" />
                    </Border>
                </StackPanel>

                <!-- Window Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource WidgetButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="Refresh Quotas" Width="24" Height="22" Margin="0,0,2,0">
                        <TextBlock Text="⟳" FontSize="14" FontWeight="Bold" RenderTransformOrigin="0.5,0.5" />
                    </Button>
                    <Button Style="{StaticResource WidgetButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize" Width="22" Height="22" Margin="0,0,2,0">
                        <TextBlock Text="−" FontSize="13" FontWeight="Bold" Margin="0,-2,0,0" />
                    </Button>
                    <Button Style="{StaticResource WidgetButtonStyle}" Click="CloseButton_Click" ToolTip="Close AIQuotaBar" Width="22" Height="22">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Body / Quota Windows -->
            <Grid Grid.Row="1" Margin="0,2,0,4">
                <!-- Active Windows View -->
                <ItemsControl ItemsSource="{Binding Windows}" Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4,0,6" Background="#202024" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <!-- Window Header -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Window Title -->
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#F4F4F5" VerticalAlignment="Center" />

                                        <!-- Remaining & Countdown info -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RemainingText}" 
                                                       FontWeight="Bold" 
                                                       FontSize="12" 
                                                       Foreground="{Binding RemainingPercent, Converter={StaticResource RemainingToBrushConverter}}" 
                                                       Margin="0,0,6,0" />

                                            <TextBlock Text="{Binding ResetCountdown}" 
                                                       FontSize="11" 
                                                       Foreground="#71717A" 
                                                       Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVisConverter}}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Progress Bar (Showing Remaining Quota) -->
                                    <Grid Height="6">
                                        <Border Background="#2E2E33" CornerRadius="3" />
                                        <ProgressBar Value="{Binding RemainingPercent, Mode=OneWay}" 
                                                     Minimum="0" 
                                                     Maximum="100" 
                                                     Height="6" 
                                                     BorderThickness="0" 
                                                     Background="Transparent"
                                                     Foreground="{Binding RemainingPercent, Converter={StaticResource RemainingToBrushConverter}}">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid x:Name="TemplateRoot">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                                        <Border x:Name="PART_Indicator" 
                                                                HorizontalAlignment="Left" 
                                                                Background="{TemplateBinding Foreground}" 
                                                                CornerRadius="3" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Status / Error / Empty View -->
                <Border Background="#27272A" CornerRadius="6" Padding="10,8" Margin="0,4,0,6"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ" FontSize="13" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#D4D4D8" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Footer -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding LastUpdatedText}" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Refreshing..." FontSize="10" Foreground="#10B981" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
