<Window x:Class="AIQuotaBar.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIQuotaBar.App.ViewModels"
        mc:Ignorable="d"
        Title="AIQuotaBar Settings"
        Icon="/Assets/AIQuotaBar.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380"
        MaxHeight="580"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <Window.Resources>
        <!-- Dark Theme CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="16" Height="16"
                                    Background="#27272A"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 3,8 L 6,11 L 13,4"
                                      Stroke="#10B981"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#10B981" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#3F3F46" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme RadioButton Style -->
        <Style x:Key="DarkRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RadioBorder"
                                    Width="16" Height="16"
                                    Background="#27272A"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="RadioDot"
                                         Width="8" Height="8"
                                         Fill="#10B981"
                                         Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#10B981" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioBorder" Property="Background" Value="#3F3F46" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#52525B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#52525B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#71717A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#52525B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Dark Vertical ScrollBar Styles for Settings Window -->
        <Style x:Key="DarkVerticalThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#3F3F46"
                                CornerRadius="2.5"
                                Width="5"
                                HorizontalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#52525B" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="#71717A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkVerticalScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkVerticalThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkVerticalScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Style="{StaticResource DarkVerticalScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Margin="2,0,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#18181B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="10"
            HorizontalAlignment="Stretch">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55" />
        </Border.Effect>

        <Grid Margin="14,12,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Window Header -->
                <RowDefinition Height="*" />    <!-- Scrollable Settings Content -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Window Header / Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="AIQuotaBar Settings"
                           FontWeight="Bold"
                           FontSize="13"
                           Foreground="#FAFAFA"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="22" Height="22"
                        Padding="0"
                        Click="CloseButton_Click"
                        ToolTip="Close"
                        AutomationProperties.Name="Close Settings">
                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Margin="0,-1,0,0" />
                </Button>
            </Grid>

            <!-- 2. Scrollable Settings Content -->
            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource DarkVerticalScrollViewerStyle}"
                          MaxHeight="430"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,12"
                          FocusVisualStyle="{x:Null}">
                <StackPanel>
                    <!-- Window Subheading -->
                    <TextBlock Text="Window"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#71717A"
                               Margin="0,0,0,8" />

                    <!-- Window Mode Card -->
                    <Border Margin="0,0,0,12"
                            Background="#1C1C20"
                            CornerRadius="7"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Window mode"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#E4E4E7"
                                       Margin="0,0,0,4" />

                            <RadioButton Style="{StaticResource DarkRadioButtonStyle}"
                                         GroupName="WindowModeGroup"
                                         IsChecked="{Binding IsFloatingDockMode, Mode=TwoWay}"
                                         Content="Floating"
                                         FontWeight="Medium"
                                         Margin="4,2,0,3"
                                         AutomationProperties.Name="Floating window mode" />

                            <RadioButton Style="{StaticResource DarkRadioButtonStyle}"
                                         GroupName="WindowModeGroup"
                                         IsChecked="{Binding IsTopDockMode, Mode=TwoWay}"
                                         Content="Dock to top"
                                         FontWeight="Medium"
                                         Margin="4,2,0,3"
                                         AutomationProperties.Name="Dock to top mode" />

                            <RadioButton Style="{StaticResource DarkRadioButtonStyle}"
                                         GroupName="WindowModeGroup"
                                         IsChecked="{Binding IsBottomDockMode, Mode=TwoWay}"
                                         Content="Dock to bottom"
                                         FontWeight="Medium"
                                         Margin="4,2,0,4"
                                         AutomationProperties.Name="Dock to bottom mode" />

                            <TextBlock Text="Docked mode shows a horizontal quota strip at the screen edge."
                                       FontSize="10.5"
                                       Foreground="#71717A"
                                       Margin="4,2,0,6"
                                       TextWrapping="Wrap" />

                            <Border Height="1" Background="#27272A" Margin="0,4,0,6" />

                            <!-- Auto-hide docked bar toggle -->
                            <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                      IsChecked="{Binding AutoHideDockedBar, Mode=TwoWay}"
                                      Content="Auto-hide docked bar"
                                      FontWeight="Medium"
                                      Margin="4,2,0,2"
                                      AutomationProperties.Name="Auto-hide docked bar" />

                            <TextBlock Text="Reveal the quota bar when you move to its screen-edge handle."
                                       FontSize="10.5"
                                       Foreground="#71717A"
                                       Margin="4,2,0,2"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Providers Subheading -->
                    <TextBlock Text="Providers"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#71717A"
                               Margin="0,0,0,4" />

                    <TextBlock Text="AIQuotaBar uses supported provider tools installed on this PC."
                               FontSize="10.5"
                               Foreground="#71717A"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap" />

                    <!-- Provider Setup Cards List -->
                    <ItemsControl ItemsSource="{Binding ProviderSetupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Background="#1C1C20"
                                        CornerRadius="7"
                                        BorderBrush="#27272A"
                                        BorderThickness="1"
                                        Padding="10,8">
                                    <StackPanel>
                                        <!-- Header: Name + Status Pill -->
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="#E4E4E7"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusLabel}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Status detail copy -->
                                        <TextBlock Text="{Binding DetailText}"
                                                   FontSize="10.5"
                                                   Foreground="#A1A1AA"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,6" />

                                        <!-- Setup Guide Action Link/Button -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Setup guide"
                                                    Command="{Binding OpenGuideCommand}"
                                                    FontSize="10.5"
                                                    Padding="8,3"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} Setup guide'}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Rescan Button -->
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Rescan providers"
                            Command="{Binding RescanCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14"
                            Padding="10,4"
                            FontSize="11"
                            AutomationProperties.Name="Rescan providers" />

                    <!-- Providers & Quotas Subheading -->
                    <TextBlock Text="Providers &amp; Quotas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#71717A"
                               Margin="0,0,0,8" />
                    <!-- Providers & Rows List -->
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Background="#1C1C20"
                                        CornerRadius="7"
                                        BorderBrush="#27272A"
                                        BorderThickness="1"
                                        Padding="10,8">
                                    <StackPanel>
                                        <!-- Provider Section Title & CheckBox -->
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#E4E4E7"
                                                   Margin="0,0,0,4" />

                                        <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  Content="Show provider"
                                                  FontWeight="Medium"
                                                  Margin="4,2,0,4"
                                                  AutomationProperties.Name="{Binding DisplayName, StringFormat='Show {0}'}" />

                                        <!-- Quota Window Rows -->
                                        <ItemsControl ItemsSource="{Binding Windows}" Margin="18,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              Content="{Binding DisplayName}"
                                                              Margin="0,2,0,2"
                                                              AutomationProperties.Name="{Binding DisplayName, StringFormat='Show {0} quota'}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Notifications Subheading -->
                    <TextBlock Text="Notifications"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#71717A"
                               Margin="0,4,0,8" />

                    <!-- Notifications Card -->
                    <Border Margin="0,0,0,6"
                            Background="#1C1C20"
                            CornerRadius="7"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            Padding="10,8">
                        <StackPanel>
                            <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                      IsChecked="{Binding LowQuotaNotificationsEnabled, Mode=TwoWay}"
                                      Content="Low quota notifications"
                                      FontWeight="Medium"
                                      Margin="4,2,0,2"
                                      AutomationProperties.Name="Low quota notifications" />
                            <TextBlock Text="Notify when visible quota drops below 10%."
                                       FontSize="10.5"
                                       Foreground="#71717A"
                                       Margin="28,0,0,2" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Bottom Action Buttons -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Reset visibility defaults"
                        Command="{Binding ResetDefaultsCommand}"
                        AutomationProperties.Name="Reset visibility defaults" />

                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Close"
                        Command="{Binding CloseCommand}"
                        IsDefault="True"
                        IsCancel="True"
                        AutomationProperties.Name="Close Settings" />
            </Grid>
        </Grid>
    </Border>
</Window>
