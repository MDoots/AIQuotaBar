<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\AIQuotaBar.ProcessFixture\AIQuotaBar.ProcessFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\AIQuotaBar.Providers.Codex\AIQuotaBar.Providers.Codex.csproj" />
    <ProjectReference Include="..\..\src\AIQuotaBar.Providers.GrokBuild\AIQuotaBar.Providers.GrokBuild.csproj" />
    <ProjectReference Include="..\..\src\AIQuotaBar.Providers.Antigravity\AIQuotaBar.Providers.Antigravity.csproj" />
    <ProjectReference Include="..\..\src\AIQuotaBar.Providers.ClaudeCode\AIQuotaBar.Providers.ClaudeCode.csproj" />
  </ItemGroup>
  <Target Name="CopyProcessFixture" AfterTargets="Build">
    <ItemGroup>
      <FixtureFiles Include="..\AIQuotaBar.ProcessFixture\bin\$(Configuration)\$(TargetFramework)\AIQuotaBar.ProcessFixture.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
